// Add to your ~/.config/zellij/config.kdl inside the keybinds { normal { ... } } block:
//
// shared_except "locked" {
//     bind "Alt p" {
//         LaunchOrFocusPlugin "file:/path/to/zj-session-picker.wasm" {
//             floating true
//             move_to_focused_tab true
//         }
//     }
// }
